// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())
  clerkUserId          String   @unique
  currentLatitude      Float?
  currentLongitude     Float?
  currentLocationName  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  travelHistory TravelHistory[]
}

enum Vehicle {
  CAR
  MOTORCYCLE
  TRUCK
}

enum JourneyStatus {
  ACTIVE
  COMPLETED
  FAILED
}

model TravelHistory {
  id                 String        @id @default(cuid())
  userId             String
  fromLatitude       Float
  fromLongitude      Float
  fromLocationName   String
  toLatitude         Float
  toLongitude        Float
  toLocationName     String
  vehicle            Vehicle
  distance           Float
  status             JourneyStatus @default(ACTIVE)
  plannedDurationSec Int?
  // Active time actually spent in-tab, excluding gaps while the tab was
  // closed or offline. Checkpointed periodically while ACTIVE; read back
  // on resume instead of the wall-clock diff from startedAt, which would
  // otherwise count time away as if the journey kept running unattended.
  elapsedActiveMs    Int           @default(0)
  startedAt          DateTime
  completedAt        DateTime
  duration           Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}
